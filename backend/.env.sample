PORT=8000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=delivery_agents
# Set to "true" in production (managed MySQL like Aiven requires SSL)
DB_SSL=false
# For managed MySQL that uses a private CA (e.g. Aiven): provide the CA cert.
# Local file path (used for local migration against Aiven):
DB_CA_PATH=
# Inline PEM contents (used on Render/prod where there is no local file):
DB_CA_CERT=

REDIS_URL=redis://localhost:6379

CACHE_TTL_SECONDS=60

CORS_ORIGIN=http://localhost:3000

JWT_SECRET=change_this_to_a_long_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Set to "true" in production so the auth cookie is sent only over HTTPS
COOKIE_SECURE=false